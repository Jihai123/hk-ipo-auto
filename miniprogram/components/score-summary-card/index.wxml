<view class="summary-card {{tone}}">
  <view class="name">{{name || code}}</view>
  <view class="code">股票代码：{{code}}</view>
  <view class="score-row">
    <view class="score">{{totalScore}}</view>
    <view class="rating-wrap">
      <view class="rating">{{ratingLabel}}</view>
      <view class="conclusion">{{conclusion}}</view>
    </view>
  </view>
</view>
