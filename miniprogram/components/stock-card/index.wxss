.stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.stock-item:last-child {
  border-bottom: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
}

.code,
.extra {
  font-size: 24rpx;
  color: #64748b;
}

.right {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f766e;
}
