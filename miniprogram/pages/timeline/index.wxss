.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.warn {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #b45309;
}

.group-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: #0f172a;
}

.empty {
  color: #64748b;
  font-size: 24rpx;
  padding: 8rpx 0;
}

.perf-item {
  border-top: 1rpx solid #e2e8f0;
  padding: 16rpx 0;
}

.perf-item:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.perf-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.perf-name {
  font-size: 28rpx;
  font-weight: 700;
}

.perf-code,
.perf-label {
  font-size: 24rpx;
  color: #64748b;
}

.perf-row {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
}

.perf-value,
.perf-main {
  font-size: 24rpx;
  color: #0f172a;
}

.perf-up { color: #0f766e; }
.perf-down { color: #b91c1c; }
.perf-flat { color: #334155; }

.perf-item {
  background: #fbfdff;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.perf-row {
  padding: 3rpx 0;
}

.perf-main {
  font-weight: 600;
}
