<view class="container">
  <view class="header card">
    <view class="title">新股时间表</view>
    <view class="meta">更新时间：{{updatedAtText}}</view>
    <view class="warn" wx:if="{{degradedTimeline}}">当前时间表数据为降级结果，请谨慎参考</view>
  </view>

  <page-state
    wx:if="{{status === 'loading'}}"
    mode="loading"
    title="加载时间表中"
    subtitle="正在获取最新新股分组..."
  />

  <page-state
    wx:elif="{{status === 'error'}}"
    mode="error"
    title="时间表加载失败"
    subtitle="{{errorInfo.message}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <page-state
    wx:elif="{{status === 'empty'}}"
    mode="empty"
    title="暂无时间表数据"
    subtitle="当前暂无可展示的新股分组"
    actionText="重试"
    bindaction="onRetry"
  />

  <block wx:else>
    <view class="group card">
      <view class="group-title">招股中</view>
      <view class="empty" wx:if="{{groups.subscribing.length === 0}}">暂无数据</view>
      <timeline-stock-card
        wx:for="{{groups.subscribing}}"
        wx:key="code"
        item="{{item}}"
        statusLabel="招股中"
        bindtapitem="onTapStock"
      />
    </view>

    <view class="group card">
      <view class="group-title">待上市</view>
      <view class="empty" wx:if="{{groups.listingSoon.length === 0}}">暂无数据</view>
      <timeline-stock-card
        wx:for="{{groups.listingSoon}}"
        wx:key="code"
        item="{{item}}"
        statusLabel="待上市"
        bindtapitem="onTapStock"
      />
    </view>

    <view class="group card">
      <view class="group-title">近期上市</view>
      <view class="empty" wx:if="{{groups.recentListed.length === 0}}">暂无数据</view>
      <timeline-stock-card
        wx:for="{{groups.recentListed}}"
        wx:key="code"
        item="{{item}}"
        statusLabel="近期上市"
        bindtapitem="onTapStock"
      />
    </view>
  </block>
</view>
