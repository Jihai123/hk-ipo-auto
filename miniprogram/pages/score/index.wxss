.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.card {
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  padding: 20rpx;
  box-sizing: border-box;
}

.conclusion-card {
  margin-bottom: 24rpx;
}

.conclusion-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.rating-label {
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.2;
}

.rating-positive { color: #15803d; }
.rating-neutral { color: #6b7280; }
.rating-negative { color: #dc2626; }

.score-badge {
  min-width: 110rpx;
  flex-shrink: 0;
  border-radius: 10px;
  border: 1rpx solid #e5e7eb;
  background: #f8fafc;
  padding: 8rpx 12rpx;
  text-align: right;
}

.score-badge-label {
  display: block;
  font-size: 19rpx;
  color: #94a3b8;
  line-height: 1.2;
}

.score-badge-value {
  display: block;
  font-size: 30rpx;
  color: #334155;
  font-weight: 600;
  line-height: 1.3;
}

.decision-text {
  display: block;
  font-size: 30rpx;
  color: #111827;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.meta-text {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
}

.back-hint {
  font-size: 24rpx;
  color: #475569;
}

.key-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10rpx;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 10rpx 0;
}

.key-row:last-child {
  border-bottom: none;
}

.key-main {
  min-width: 0;
  flex: 1;
  font-size: 27rpx;
  color: #1f2937;
  line-height: 1.5;
}

.key-name {
  font-weight: 600;
}

.key-reason {
  color: #334155;
}

.key-score {
  font-size: 24rpx;
  color: #64748b;
  white-space: nowrap;
}

.empty-row,
.other-line,
.empty-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.collapse-header,
.sub-collapse-header {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.collapse-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.collapse-arrow {
  font-size: 26rpx;
  color: #94a3b8;
}

.collapse-body {
  margin-top: 6rpx;
}

.dimension-item {
  border-top: 1rpx solid #f1f5f9;
  padding: 12rpx 0;
}

.dimension-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 8rpx;
}

.dimension-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #111827;
}

.dimension-score {
  font-size: 24rpx;
  color: #64748b;
}

.dimension-summary {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
}

.sub-title {
  font-size: 24rpx;
  color: #64748b;
}

.evidence-detail {
  margin-top: 4rpx;
  padding: 8rpx 10rpx;
  border-radius: 10px;
  border: 1rpx dashed rgba(148, 163, 184, 0.25);
  background: rgba(248, 250, 252, 0.7);
}

.evidence-line {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(71, 85, 105, 0.82);
}

.evidence-label {
  color: rgba(100, 116, 139, 0.78);
}

.evidence-value {
  color: rgba(71, 85, 105, 0.82);
}

.evidence-snippet {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  color: rgba(71, 85, 105, 0.75);
}
