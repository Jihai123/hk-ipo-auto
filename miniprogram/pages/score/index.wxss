.page {
  min-height: 100vh;
  background: #eef3fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.section { margin-bottom: 24rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 10rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
  padding: 20rpx;
  box-sizing: border-box;
}

.hero-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  background: linear-gradient(145deg, #0b1f4d, #1d2f6f 60%, #243b87);
  color: #e2e8f0;
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.25);
}

.hero-stock { display: flex; align-items: baseline; gap: 10rpx; }
.stock-name { font-size: 32rpx; font-weight: 700; color: #f8fafc; }
.stock-code { font-size: 24rpx; color: rgba(226, 232, 240, 0.8); }

.hero-main {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.rating-label { font-size: 56rpx; font-weight: 700; line-height: 1.2; }
.rating-positive { color: #4ade80; }
.rating-neutral { color: #cbd5e1; }
.rating-negative { color: #fca5a5; }

.score-badge {
  min-width: 120rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  padding: 10rpx 14rpx;
  text-align: right;
}

.score-badge-label { display: block; font-size: 20rpx; color: rgba(226, 232, 240, 0.7); }
.score-badge-value { display: block; font-size: 34rpx; font-weight: 700; color: #f8fafc; }

.decision-text {
  margin-top: 12rpx;
  display: block;
  font-size: 28rpx;
  color: #e2e8f0;
  line-height: 1.6;
}

.hero-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.status-chip {
  font-size: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  padding: 6rpx 14rpx;
}

.perf-text { font-size: 22rpx; color: #cbd5e1; }
.back-hint { margin-top: 12rpx; font-size: 24rpx; color: rgba(226, 232, 240, 0.9); }

.key-card { margin-bottom: 10rpx; }
.key-head { display: flex; justify-content: space-between; align-items: baseline; }
.key-name { font-size: 29rpx; font-weight: 600; color: #0f172a; }
.key-score { font-size: 24rpx; color: #475569; }
.key-summary { margin-top: 6rpx; font-size: 24rpx; color: #475569; line-height: 1.5; }

.bar-track {
  margin-top: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.bar-fill { height: 100%; border-radius: 999rpx; }
.bar-positive { background: #16a34a; }
.bar-negative { background: #dc2626; }
.bar-neutral { background: #64748b; }

.empty-row,
.empty-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.collapse-header {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.collapse-title { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.collapse-arrow { font-size: 26rpx; color: #94a3b8; }
.collapse-body { margin-top: 6rpx; }

.dimension-item {
  border-top: 1rpx solid #f1f5f9;
  padding: 14rpx 0;
}

.dimension-head { display: flex; justify-content: space-between; align-items: baseline; }
.dimension-name { font-size: 27rpx; font-weight: 600; color: #111827; }
.dimension-score { font-size: 24rpx; color: #64748b; }
.dimension-summary { margin-top: 6rpx; font-size: 24rpx; color: #475569; }

.evidence-detail,
.rule-detail {
  margin-top: 8rpx;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
}

.evidence-detail {
  border: 1rpx dashed rgba(148, 163, 184, 0.35);
  background: rgba(248, 250, 252, 0.86);
}

.rule-detail {
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  background: rgba(239, 246, 255, 0.86);
}

.evidence-line {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #475569;
}

.evidence-label { color: #64748b; }
.evidence-value { color: #334155; }
.evidence-snippet {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  color: #475569;
}

.market-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.market-item {
  border-radius: 12rpx;
  background: #f8fafc;
  padding: 14rpx;
}

.market-compact .market-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 10rpx 0;
}

.market-compact .market-row:last-child { border-bottom: none; }

.market-label { display: block; font-size: 22rpx; color: #64748b; }
.market-value { display: block; margin-top: 4rpx; font-size: 28rpx; color: #0f172a; font-weight: 600; }

.review-detail-hero {
  background: linear-gradient(145deg, #1e293b, #334155);
}

.review-disclaimer {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #334155;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
}
