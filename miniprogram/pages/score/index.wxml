<view class="page detail-page">
  <page-state
    wx:if="{{status === 'loading'}}"
    mode="loading"
    title="{{reviewMode ? '数据加载中' : '评分生成中'}}"
    subtitle="{{loadingText}}"
  />

  <page-state
    wx:elif="{{status === 'empty'}}"
    mode="empty"
    title="{{reviewMode ? '暂无可展示信息' : '暂无可展示评分结果'}}"
    subtitle="{{errorInfo.message}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <page-state
    wx:elif="{{status === 'error'}}"
    mode="error"
    title="{{reviewMode ? '数据获取失败' : '评分获取失败'}}"
    subtitle="{{errorInfo.message}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <block wx:else>
    <block wx:if="{{reviewMode}}">
      <view class="hero-card review-detail-hero">
        <view class="hero-stock">
          <text class="stock-name">{{scoreData.name}}</text>
          <text class="stock-code">{{scoreData.code}}</text>
        </view>
        <text class="decision-text">{{detailViewModel.summaryText}}</text>
      </view>

      <view class="section">
        <view class="section-title">{{detailViewModel.infoTitle}}</view>
        <view class="card market-compact">
          <view class="market-row" wx:for="{{detailViewModel.summaryRows}}" wx:key="label">
            <text class="market-label">{{item.label}}</text>
            <text class="market-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view class="section" wx:for="{{detailViewModel.sections}}" wx:key="key">
        <view class="section-title">{{item.title}}</view>
        <view class="card market-compact">
          <view class="market-row" wx:for="{{item.rows}}" wx:key="label">
            <text class="market-label">{{item.label}}</text>
            <text class="market-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view class="card review-disclaimer">{{detailViewModel.disclaimer}}</view>
    </block>

    <block wx:else>
<view class="hero-card">
      <view class="hero-stock">
        <text class="stock-name">{{scoreData.name}}</text>
        <text class="stock-code">{{scoreData.code}}</text>
      </view>

      <view class="hero-main">
        <text class="rating-label {{scoreData.toneClass}}">{{scoreData.ratingLabel}}</text>
        <view class="score-badge">
          <text class="score-badge-label">Score</text>
          <text class="score-badge-value">{{scoreData.totalScoreText}}</text>
        </view>
      </view>

      <text class="decision-text">{{scoreData.decisionSentence}}</text>
      <view class="hero-meta">
        <text class="status-chip">{{scoreData.statusText}}</text>
        <text wx:if="{{scoreData.performanceText}}" class="perf-text">上市后表现 {{scoreData.performanceText}}</text>
      </view>
      <view class="back-hint" bindtap="onBackHome">返回首页</view>
    </view>

    <view class="section">
      <view class="section-title">关键维度</view>
      <view class="key-list">
        <block wx:if="{{keyFactors.length > 0}}">
          <view class="card key-card" wx:for="{{keyFactors}}" wx:key="key">
            <view class="key-head">
              <text class="key-name">{{item.label}}</text>
              <text class="key-score">{{item.scoreText}}</text>
            </view>
            <text class="key-summary">{{item.summaryText}}</text>
            <view class="bar-track">
              <view class="bar-fill {{item.barClass}}" style="width: {{item.barWidth}};"></view>
            </view>
          </view>
        </block>
        <view wx:else class="card empty-row">
          <text class="empty-text">当前维度信号不突出，建议结合市场信息判断</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="card evidence-card">
        <view class="collapse-header" bindtap="toggleEvidenceOpen">
          <text class="collapse-title">完整评分依据</text>
          <text class="collapse-arrow">{{evidenceOpen ? '⌃' : '⌄'}}</text>
        </view>

        <view wx:if="{{evidenceOpen}}" class="collapse-body">
          <view class="dimension-item" wx:for="{{allDimensions}}" wx:key="key">
            <view class="dimension-head">
              <text class="dimension-name">{{item.label}}</text>
              <text class="dimension-score">{{item.scoreText}}</text>
            </view>
            <view class="dimension-summary">{{item.summaryText}}</view>

            <view class="evidence-detail">
              <view class="evidence-line" wx:for="{{item.evidence.rows}}" wx:for-item="row" wx:key="label">
                <text class="evidence-label">{{row.label}}：</text>
                <text class="evidence-value">{{row.value}}</text>
              </view>

              <view class="evidence-line">
                <text class="evidence-label">原文片段：</text>
                <text class="evidence-snippet">{{item.evidence.snippetText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">相关市场信息</view>
      <view wx:if="{{marketInfo.mode === 'grid'}}" class="card market-grid">
        <view class="market-item" wx:for="{{marketInfo.items}}" wx:key="key">
          <text class="market-label">{{item.label}}</text>
          <text class="market-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:elif="{{marketInfo.mode === 'compact'}}" class="card market-compact">
        <view class="market-row" wx:for="{{marketInfo.items}}" wx:key="key">
          <text class="market-label">{{item.label}}</text>
          <text class="market-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:else class="card market-empty">
        <text class="empty-text">市场数据待更新</text>
      </view>
    </view>
    </block>
  </block>
</view>
