<view class="page detail-page">
  <page-state
    wx:if="{{status === 'loading'}}"
    mode="loading"
    title="评分生成中"
    subtitle="{{loadingText}}"
  />

  <page-state
    wx:elif="{{status === 'empty'}}"
    mode="empty"
    title="暂无可展示评分结果"
    subtitle="{{errorInfo.message}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <page-state
    wx:elif="{{status === 'error'}}"
    mode="error"
    title="评分获取失败"
    subtitle="{{errorInfo.message}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <block wx:else>
    <view class="card conclusion-card">
      <view class="conclusion-top">
        <text class="rating-label {{scoreData.toneClass}}">{{scoreData.ratingLabel}}</text>
        <view class="score-badge">
          <text class="score-badge-label">Score</text>
          <text class="score-badge-value">{{scoreData.totalScoreText}}</text>
        </view>
      </view>

      <text class="decision-text">{{scoreData.decisionSentence}}</text>
      <text class="meta-text">score {{scoreData.totalScoreText}}</text>

      <view class="back-hint" bindtap="onBackHome">返回首页</view>
    </view>

    <view class="section">
      <view class="section-title">关键维度</view>
      <view class="card key-card">
        <block wx:if="{{keyFactors.length > 0}}">
          <view class="key-row" wx:for="{{keyFactors}}" wx:key="key">
            <view class="key-main">
              <text class="key-icon">{{item.icon}}</text>
              <text class="key-name">{{item.label}}</text>
              <text class="key-reason">：{{item.summaryText}}</text>
            </view>
            <text class="key-score">{{item.scoreText}}</text>
          </view>
        </block>
        <view wx:else class="empty-row">
          <text class="empty-text">暂无关键维度</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="card">
        <text class="other-line">其他维度暂无明显优势</text>
      </view>
    </view>

    <view class="section">
      <view class="card evidence-card">
        <view class="collapse-header" bindtap="toggleEvidenceOpen">
          <text class="collapse-title">评分依据</text>
          <text class="collapse-arrow">{{evidenceOpen ? '⌃' : '⌄'}}</text>
        </view>

        <view wx:if="{{evidenceOpen}}" class="collapse-body">
          <view class="dimension-item" wx:for="{{allDimensions}}" wx:key="key">
            <view class="dimension-head">
              <text class="dimension-name">{{item.label}}</text>
              <text class="dimension-score">{{item.scoreText}}</text>
            </view>

            <view class="dimension-summary">{{item.summaryText}}</view>

            <view class="sub-collapse-header" bindtap="toggleDimensionEvidence" data-index="{{index}}">
              <text class="sub-title">证据</text>
              <text class="collapse-arrow">{{item.evidenceOpen ? '⌃' : '⌄'}}</text>
            </view>

            <view wx:if="{{item.evidenceOpen}}" class="evidence-detail">
              <view class="evidence-line">
                <text class="evidence-label">数据来源：</text>
                <text class="evidence-value">{{item.sourceText}}</text>
              </view>
              <view class="evidence-line">
                <text class="evidence-label">命中关键词：</text>
                <text class="evidence-value">{{item.keywordText}}</text>
              </view>
              <view class="evidence-line">
                <text class="evidence-label">原文片段：</text>
                <text class="evidence-snippet">{{item.snippetText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
