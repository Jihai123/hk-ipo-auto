.hero .title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero .subtitle {
  color: #475569;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.search-input {
  flex: 1;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
}

.search-btn {
  width: 140rpx;
  background: #0f766e;
  color: #fff;
  font-size: 24rpx;
}

.recent-wrap {
  margin: 12rpx 0 14rpx;
}

.recent-title {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.recent-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.recent-item {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #1e293b;
  font-size: 24rpx;
}

.state-box {
  text-align: center;
}

.error {
  color: #b91c1c;
}

.warn {
  color: #b45309;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.empty {
  color: #64748b;
  font-size: 24rpx;
  padding: 8rpx 0 12rpx;
}

.group-title {
  margin-top: 10rpx;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.timeline-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.timeline-item:last-child {
  border-bottom: none;
}
