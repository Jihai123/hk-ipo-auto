.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.sub-section {
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}

.card {
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  padding: 20rpx;
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.card-clickable {
  cursor: pointer;
}

.card-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

.state-card {
  text-align: center;
  color: #334155;
}

.error-card {
  color: #b91c1c;
}

.recommend-card {
  margin-bottom: 12rpx;
}

.stock-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.stock-left {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: baseline;
}

.stock-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
}

.stock-code {
  font-size: 24rpx;
  color: #6b7280;
}

.level-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid transparent;
}

.level-strong {
  color: #166534;
  background: #ecfdf3;
  border-color: #bbf7d0;
}

.level-watch {
  color: #92400e;
  background: #fffbeb;
  border-color: #fde68a;
}

.level-wait {
  color: #6b7280;
  background: #f3f4f6;
  border-color: #e5e7eb;
}

.conclusion-line {
  margin-bottom: 6rpx;
}

.rating-label {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.rating-positive { color: #15803d; }
.rating-neutral { color: #6b7280; }
.rating-negative { color: #dc2626; }

.reason-line {
  margin-bottom: 10rpx;
}

.reason-text {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.4;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #9ca3af;
}

.window-item-card {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  margin-bottom: 10rpx;
}

.window-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.window-left {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.window-left .stock-name {
  font-size: 28rpx;
}

.window-empty-card {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.sentiment-bar {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}

.sentiment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.sentiment-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sentiment-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9ca3af;
}

.sentiment-hot { background: #f59e0b; }
.sentiment-neutral { background: #9ca3af; }
.sentiment-cold { background: #3b82f6; }

.sentiment-value {
  font-size: 26rpx;
  color: #334155;
}
