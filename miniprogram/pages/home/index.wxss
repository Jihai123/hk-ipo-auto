.page {
  min-height: 100vh;
  background: #eef3fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.section-note,
.section-more {
  font-size: 24rpx;
  color: #64748b;
}

.hero-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  background: linear-gradient(145deg, #0b1f4d, #1d2f6f 60%, #243b87);
  color: #eef2ff;
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.26);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(226, 232, 255, 0.86);
}

.hero-conclusion {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.hero-metrics {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.hero-metric {
  flex: 1;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.12);
  padding: 12rpx;
}

.hero-metric-label {
  display: block;
  font-size: 22rpx;
  color: rgba(226, 232, 255, 0.8);
}

.hero-metric-value {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-cta {
  margin-top: 18rpx;
  width: 180rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 10rpx 0;
  font-size: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
  padding: 20rpx;
  box-sizing: border-box;
}

.card-clickable { cursor: pointer; }
.card-hover { transform: scale(0.985); opacity: 0.92; }

.state-card { text-align: center; color: #334155; }
.error-card { color: #b91c1c; }

.recommend-card,
.listed-card {
  margin-bottom: 12rpx;
}

.stock-line,
.listed-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10rpx;
}

.stock-left {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: baseline;
}

.stock-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.stock-code {
  font-size: 23rpx;
  color: #64748b;
}

.level-badge,
.status-chip {
  flex-shrink: 0;
  font-size: 21rpx;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.level-strong { color: #166534; background: #ecfdf3; }
.level-watch { color: #92400e; background: #fffbeb; }
.level-wait { color: #64748b; background: #f1f5f9; }

.conclusion-line {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.rating-label {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.rating-positive { color: #16a34a; }
.rating-neutral { color: #64748b; }
.rating-negative { color: #dc2626; }

.status-sub { color: #0f766e; background: #ccfbf1; }
.status-soon { color: #1d4ed8; background: #dbeafe; }
.status-listed { color: #4f46e5; background: #e0e7ff; }
.status-unknown { color: #64748b; background: #e2e8f0; }

.reason-line { margin-top: 8rpx; }
.reason-text { font-size: 25rpx; color: #334155; line-height: 1.5; }

.meta-line,
.listed-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.listed-perf {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.listed-arrow { font-size: 24rpx; }
.listed-perf-text {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
}

.perf-up { color: #16a34a; }
.perf-down { color: #dc2626; }
.perf-flat { color: #64748b; }

.listed-metrics {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.listed-metric {
  min-width: 170rpx;
  padding: 8rpx 10rpx;
  border-radius: 10rpx;
  background: #f8fafc;
}

.listed-metric-label {
  display: block;
  font-size: 20rpx;
  color: #64748b;
}

.listed-metric-value {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #0f172a;
  font-weight: 600;
}

.sub-section { margin-bottom: 14rpx; }
.sub-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}

.window-item-card { padding-top: 16rpx; padding-bottom: 16rpx; margin-bottom: 8rpx; }
.window-row { display: flex; justify-content: space-between; align-items: center; gap: 10rpx; }
.window-left { min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.window-left .stock-name { font-size: 28rpx; }

.empty-text { font-size: 24rpx; color: #94a3b8; }

.method-entry { background: #f8fbff; border: 1rpx solid #dbe7ff; }
.method-title { display: block; font-size: 28rpx; font-weight: 600; color: #1e293b; }
.method-text { display: block; margin-top: 8rpx; font-size: 24rpx; color: #64748b; }
