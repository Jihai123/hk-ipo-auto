<view class="page home-page">
  <view wx:if="{{loading}}" class="card state-card">加载中...</view>

  <view wx:elif="{{error}}" class="card state-card error-card">
    <view>加载失败：{{error}}</view>
    <button size="mini" bindtap="loadHomeData">重试</button>
  </view>

  <block wx:else>
    <view class="section">
      <view class="section-title">今日推荐</view>

      <block wx:if="{{topRecommendations.length > 0}}">
        <view
          class="card recommend-card card-clickable"
          wx:for="{{topRecommendations}}"
          wx:key="code"
          hover-class="card-hover"
          hover-stay-time="80"
          bindtap="onTapRecommendCard"
          data-code="{{item.code}}"
        >
          <view class="stock-line">
            <view class="stock-left">
              <text class="stock-name">{{item.nameText}}</text>
              <text class="stock-code">{{item.codeText}}</text>
            </view>
            <text class="level-badge {{item.levelClass}}">{{item.levelText}}</text>
          </view>

          <view class="conclusion-line">
            <text class="rating-label {{item.ratingToneClass}}">{{item.ratingLabelText}}</text>
          </view>

          <view class="reason-line">
            <text class="reason-text">{{item.shortReasonText}}</text>
          </view>

          <view class="meta-line">
            <text class="meta-text">score {{item.scoreText}}</text>
            <text class="meta-text">上市 {{item.listingDateText}}</text>
          </view>
        </view>
      </block>

      <view wx:else class="card empty-card">
        <text class="empty-text">今日暂无可推荐标的</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">时间窗口</view>

      <view class="sub-section">
        <view class="sub-title">招股中</view>
        <block wx:if="{{windowGroups.subscribing.length > 0}}">
          <view
            class="card window-item-card card-clickable"
            wx:for="{{windowGroups.subscribing}}"
            wx:key="code"
            hover-class="card-hover"
            hover-stay-time="80"
            bindtap="onTapWindowCard"
            data-code="{{item.code}}"
          >
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无招股中项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">待上市</view>
        <block wx:if="{{windowGroups.listingSoon.length > 0}}">
          <view
            class="card window-item-card card-clickable"
            wx:for="{{windowGroups.listingSoon}}"
            wx:key="code"
            hover-class="card-hover"
            hover-stay-time="80"
            bindtap="onTapWindowCard"
            data-code="{{item.code}}"
          >
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无待上市项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">近期上市</view>
        <block wx:if="{{windowGroups.recentListed.length > 0}}">
          <view
            class="card window-item-card card-clickable"
            wx:for="{{windowGroups.recentListed}}"
            wx:key="code"
            hover-class="card-hover"
            hover-stay-time="80"
            bindtap="onTapWindowCard"
            data-code="{{item.code}}"
          >
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无近期上市项目</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="sentiment-bar">
        <text class="sentiment-title">市场情绪</text>
        <view class="sentiment-right">
          <text class="sentiment-dot {{marketSentiment.className}}"></text>
          <text class="sentiment-value">{{marketSentiment.text}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
