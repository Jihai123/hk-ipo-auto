<view class="page home-page">
  <view wx:if="{{loading}}" class="card state-card">加载中...</view>

  <view wx:elif="{{error}}" class="card state-card error-card">
    <view>加载失败：{{error}}</view>
    <button size="mini" bindtap="loadHomeData">重试</button>
  </view>

  <block wx:else>
    <view class="hero-card">
      <view class="hero-top">
        <text class="hero-title">港股打新专家</text>
        <text class="hero-subtitle">新股评分 × 市场表现 × 关键依据</text>
      </view>

      <view class="hero-market">
        <text class="hero-conclusion">{{heroConclusion}}</text>
        <text class="market-chip {{marketSentiment.className}}">市场 {{marketSentiment.text}}</text>
      </view>

      <view class="hero-search-row">
        <input class="hero-input" placeholder="输入股票代码（如 02628）" maxlength="5" value="{{searchCode}}" bindinput="onSearchInput" />
        <view class="hero-search-btn" bindtap="onSearchSubmit">查看评分</view>
      </view>

      <view wx:if="{{recentSearches.length > 0}}" class="recent-row">
        <text class="recent-label">最近查询</text>
        <view class="recent-tags">
          <text class="recent-tag" wx:for="{{recentSearches}}" wx:key="*this" data-code="{{item}}" bindtap="onTapRecentSearch">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view class="section-title">今日优先看</view>
        <view class="section-note">聚焦个股</view>
      </view>

      <block wx:if="{{topRecommendations.length > 0}}">
        <view class="card recommend-card card-clickable" wx:for="{{topRecommendations}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapRecommendCard" data-code="{{item.code}}">
          <view class="stock-line">
            <view class="stock-left">
              <text class="stock-name">{{item.nameText}}</text>
              <text class="stock-code">{{item.codeText}}</text>
            </view>
            <text class="status-chip {{item.statusClass}}">{{item.statusText}}</text>
          </view>

          <view class="conclusion-line">
            <text class="rating-label {{item.mainRatingClass}}">{{item.mainRatingText}}</text>
          </view>

          <view class="reason-line">
            <text class="reason-text">{{item.shortReasonText}}</text>
          </view>

          <view class="meta-line">
            <text class="meta-text">score {{item.scoreText}}</text>
            <text wx:if="{{item.listingDateText}}" class="meta-text">上市 {{item.listingDateText}}</text>
          </view>
        </view>
      </block>

      <view wx:else class="card empty-card">
        <text class="empty-text">今日暂无可推荐标的</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view class="section-title">近期上市表现</view>
        <view class="section-more" bindtap="onTapTimelineMore" data-target="recentPerformance">查看全部</view>
      </view>
      <block wx:if="{{recentPerformance.length > 0}}">
        <view class="card listed-card" wx:for="{{recentPerformance}}" wx:key="code">
          <view class="listed-head">
            <text class="stock-name">{{item.nameText}}</text>
            <text class="stock-code">{{item.codeText}}</text>
          </view>
          <view class="listed-perf {{item.perfClass}}">
            <text class="listed-arrow">{{item.perfArrow}}</text>
            <text class="listed-perf-text">{{item.perfText}}</text>
          </view>
          <view class="listed-metrics" wx:if="{{item.metrics.length > 0}}">
            <view class="listed-metric" wx:for="{{item.metrics}}" wx:key="label">
              <text class="listed-metric-label">{{item.label}}</text>
              <text class="listed-metric-value">{{item.value}}</text>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="card empty-card">
        <text class="empty-text">近期暂无可展示上市样本</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view class="section-title">新股时间表</view>
        <view class="section-more" bindtap="onTapTimelineMore" data-target="timeline">查看全部</view>
      </view>

      <view class="sub-section">
        <view class="sub-title">今日暗盘</view>
        <block wx:if="{{windowGroups.todayGreyMarket.length > 0}}">
          <view class="card window-item-card card-clickable" wx:for="{{windowGroups.todayGreyMarket}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapWindowCard" data-code="{{item.code}}">
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无今日暗盘项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">今日上市</view>
        <block wx:if="{{windowGroups.todayListed.length > 0}}">
          <view class="card window-item-card card-clickable" wx:for="{{windowGroups.todayListed}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapWindowCard" data-code="{{item.code}}">
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无今日上市项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">招股中</view>
        <block wx:if="{{windowGroups.subscribing.length > 0}}">
          <view class="card window-item-card card-clickable" wx:for="{{windowGroups.subscribing}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapWindowCard" data-code="{{item.code}}">
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无招股中项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">即将上市</view>
        <block wx:if="{{windowGroups.listingSoon.length > 0}}">
          <view class="card window-item-card card-clickable" wx:for="{{windowGroups.listingSoon}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapWindowCard" data-code="{{item.code}}">
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无即将上市项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">申请上市（通过聆讯）</view>
        <block wx:if="{{windowGroups.hearingPassed.length > 0}}">
          <view class="card window-item-card card-clickable" wx:for="{{windowGroups.hearingPassed}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapWindowCard" data-code="{{item.code}}">
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无通过聆讯项目</text>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">近期新股信息</view>
        <block wx:if="{{windowGroups.recentNewStocks.length > 0}}">
          <view class="card window-item-card card-clickable" wx:for="{{windowGroups.recentNewStocks}}" wx:key="code" hover-class="card-hover" hover-stay-time="80" bindtap="onTapWindowCard" data-code="{{item.code}}">
            <view class="window-row">
              <view class="window-left">
                <text class="stock-name">{{item.nameText}}</text>
                <text class="stock-code">{{item.codeText}}</text>
              </view>
              <text class="meta-text">{{item.listingDateText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="card window-empty-card">
          <text class="empty-text">当前无近期新股信息</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="method-entry card card-clickable" bindtap="onOpenMethodPanel">
        <text class="method-title">评分方法轻入口</text>
        <text class="method-text">查看 6 个核心维度与一句话解释</text>
      </view>
    </view>

    <view wx:if="{{showMethodPanel}}" class="method-mask" bindtap="onCloseMethodPanel">
      <view class="method-panel" catchtap="onPanelTap">
        <view class="method-head">
          <text class="method-panel-title">评分方法（轻量）</text>
          <text class="method-close" bindtap="onCloseMethodPanel">关闭</text>
        </view>
        <view class="method-item" wx:for="{{methodItems}}" wx:key="name">
          <text class="method-item-name">{{item.name}}</text>
          <text class="method-item-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
